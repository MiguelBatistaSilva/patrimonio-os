# Modelo de configuração. COPIE este arquivo para ".env" e preencha a senha.
# O arquivo .env de verdade NÃO deve ir para o git (contém senha).

# Formato: postgresql+psycopg2://USUARIO:SENHA@HOST:PORTA/BANCO
# Atenção à PORTA: no seu PC de dev é 5433; numa instalação nova do PostgreSQL costuma
# ser 5432. Se a senha tiver "@", troque por "%40". O "?sslmode=disable" só é preciso
# se houver a env var global PGSSLMODE=require (caso do PC de dev).
DATABASE_URL=postgresql+psycopg2://patrimonio_app:SUA_SENHA_AQUI@localhost:5433/patrimonio?sslmode=disable

# SÓ EM PRODUÇÃO (máquina que hospeda o app, ex.: PC do chefe): nome de rede ou IP dela.
# Deixe em branco em desenvolvimento (o app usa localhost). Veja o nome com: hostname
# APP_HOST=NOME-DO-PC
